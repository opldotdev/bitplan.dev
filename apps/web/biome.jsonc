{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "files": {
    "includes": [
      // Standalone publishable documents have their own upload-policy and behavior tests.
      "!!public/templates",
      // Canonical copies live in skills/gateway/scripts; keep the published
      // well-known tree byte-identical so $SKILL_DIR/scripts works.
      "!!public/.well-known/agent-skills/gateway/scripts",
      "!src/components/ui",
      "!src/hooks/use-mobile.ts"
    ]
  },
  "linter": {
    "rules": {
      "complexity": {
        // Event handlers intentionally mark fire-and-forget UI work with `void`.
        "noVoid": "off"
      },
      "performance": {
        // Inline handlers are clearer here; no memoized child depends on their identity.
        "noJsxPropsBind": "off"
      }
    }
  }
}
